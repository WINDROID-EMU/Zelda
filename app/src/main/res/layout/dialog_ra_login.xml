<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#13161C"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ra_login_title"
        android:textColor="#FFD700"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp"
        android:text="@string/ra_login_hint"
        android:textColor="#8B9BB4"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/et_ra_username"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/edit_text_bg"
        android:hint="@string/ra_username"
        android:inputType="textNoSuggestions"
        android:padding="8dp"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/et_ra_password"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/edit_text_bg"
        android:hint="@string/ra_password"
        android:inputType="textPassword"
        android:padding="8dp"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <CheckBox
        android:id="@+id/cb_ra_show_password"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/ra_show_password"
        android:textColor="#B0C2DE"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tv_ra_login_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#FFD700"
        android:textSize="11sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="right"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_ra_login_cancel"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/btn_dark"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="@string/ra_cancel"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_ra_login_submit"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/btn_gold"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="@string/ra_btn_login"
            android:textColor="#1A1500"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
